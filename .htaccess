RewriteEngine On
RewriteBase /

# Serve real static files from public/ (CSS, JS, images, uploads, etc.)
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
RewriteRule ^(.*)$ public/$1 [L]

# Route all app requests through public/index.php with the path as ?url=
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
